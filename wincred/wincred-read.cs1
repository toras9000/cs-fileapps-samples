#!/usr/bin/env -S dotnet run --file
#:package Lestaly.General@0.147.0
#:package NebriaChip.Vault.Win@1.1.0
#:property TargetFramework=net10.0-windows7.0
using System.Text.Json.Serialization;
using Lestaly;
using NebriaChip.Vault.Win;

return await Paved.ProceedAsync(async () =>
{
    var credName = "SampleScript-TestCred";

    var adapter = new PersistVaultAdapter();
    var secret = adapter.ReadGenericObject(credName, JsonContext.Default.SecretData);
    if (secret == null)
    {
        Console.WriteLine($"Credential not found");
    }
    else
    {
        Console.WriteLine($"Existing credential: User={secret.User}, Paltform={secret.Platform}, Timestamp={secret.Time}");
    }
});

record SecretData(string User, Version Platform, DateTime Time);

[JsonSerializable(typeof(SecretData[]))]
internal partial class JsonContext : JsonSerializerContext;
